[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.3
reloadable = true

[libraries]

windows.debug.x86_64   = "res://../rust/target/release/charge_field_modeler.dll"
windows.release.x86_64 = "res://../rust/target/release/charge_field_modeler.dll"
linux.debug.x86_64     = "res://../rust/target/debug/libcharge_field_modeler.so"
linux.release.x86_64   = "res://../rust/target/release/libcharge_field_modeler.so"
macos.debug            = "res://../rust/target/debug/libcharge_field_modeler.dylib"
macos.release          = "res://../rust/target/release/libcharge_field_modeler.dylib"
macos.debug.arm64      = "res://../rust/target/debug/libcharge_field_modeler.dylib"
macos.release.arm64    = "res://../rust/target/release/libcharge_field_modeler.dylib"
