[node name="DynamicsBtn" type="OptionButton" parent="ScenarioPanel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "RigidLock: phase-driven display (presentable default).
RigidAlpha: alphas become rigid bodies, forces act between them.
FreeNucleon: every nucleon integrates freely (research sandbox).
Switching back to RigidLock snaps the nucleus to its rest pose.
RigidAlpha/FreeNucleon are untuned: multi-alpha nuclei fly apart."

